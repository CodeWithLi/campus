<view class="chat-row {{role === 'user' ? 'user' : 'assistant'}}">
  <view class="bubble {{role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
    <view wx:if="{{role === 'user' && attachments && attachments.length}}" class="attach-row">
      <view
        wx:for="{{attachments}}"
        wx:key="title"
        class="attach-chip"
      >
        <text class="attach-icon">📄</text>
        <text class="attach-title">{{item.title || item.originalFileName || '文件'}}</text>
      </view>
    </view>

    <view wx:if="{{thinking}}" class="thinking-wrap">
      <text class="thinking-text">正在思考中</text>
      <view class="thinking-dots">
        <text class="dot dot-1">•</text>
        <text class="dot dot-2">•</text>
        <text class="dot dot-3">•</text>
      </view>
    </view>
    <text wx:elif="{{role === 'assistant' && streaming}}" user-select>{{content}}</text>
    <towxml wx:elif="{{role === 'assistant'}}" nodes="{{towxmlNodes}}"></towxml>
    <text wx:else user-select>{{content}}</text>
  </view>
</view>

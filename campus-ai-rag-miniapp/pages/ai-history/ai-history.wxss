.page {
  min-height: 100vh;
  background: #f8fafc;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
}

.new-chat {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  color: #111827;
  border-radius: 14rpx;
  background: #f1f5f9;
  margin-bottom: 18rpx;
  font-weight: 600;
}

.empty {
  margin-top: 80rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.history-card {
  border-radius: 12rpx;
  padding: 18rpx 10rpx;
  margin-bottom: 8rpx;
}

.history-title {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 500;
}

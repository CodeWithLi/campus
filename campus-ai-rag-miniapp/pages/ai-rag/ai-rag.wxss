.page {
  height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.bg-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: linear-gradient(150deg, #dfeaff, #eef4ff, #e0ecff);
  background-size: 220% 220%;
  animation: gradientFlow 9s ease infinite;
  z-index: 0;
}

.top-bar {
  margin: 16rpx 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.top-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.left-placeholder {
  opacity: 0;
}

.model-switch {
  min-width: 280rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 22rpx rgba(59, 130, 246, 0.2);
  border: 1rpx solid rgba(147, 197, 253, 0.5);
}

.model-text {
  background: linear-gradient(90deg, #2563eb, #7c3aed, #06b6d4, #2563eb);
  background-size: 220% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: modelShine 3.2s linear infinite;
}

.model-arrow {
  color: #3b82f6;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 20rpx 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.empty-card {
  background: linear-gradient(145deg, #ffffff, #f8fbff);
  border: 1rpx solid #dbeafe;
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 28rpx rgba(59, 130, 246, 0.12);
  position: relative;
  overflow: hidden;
  animation: cardFloat 4.2s ease-in-out infinite;
}

.empty-card::after {
  content: '';
  position: absolute;
  top: -160rpx;
  right: -140rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.16), rgba(59, 130, 246, 0));
  animation: haloMove 6.5s ease-in-out infinite;
}

.empty-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 16rpx rgba(59, 130, 246, 0.28);
  animation: badgePulse 2.6s ease-in-out infinite;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 38rpx;
  color: #0f172a;
  font-weight: 600;
}

.empty-desc {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.suggestion-row {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.suggestion-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 500;
  color: #3b82f6;
  background: #edf4ff;
  border: 1rpx solid #dbeafe;
  transition: transform 180ms ease, box-shadow 180ms ease;
  animation: chipFadeIn 420ms ease both;
}

.suggestion-chip:active {
  transform: translateY(-2rpx) scale(1.03);
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.22);
}

.suggestion-chip:nth-child(2) {
  animation-delay: 80ms;
}

.suggestion-chip:nth-child(3) {
  animation-delay: 160ms;
}

.guide-grid {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.guide-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(59, 130, 246, 0.07);
}

.guide-title {
  color: #1e293b;
  font-size: 27rpx;
  font-weight: 600;
}

.guide-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.ambient-block {
  height: 220rpx;
  position: relative;
  margin-top: 8rpx;
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
}

.ambient-orb-a {
  width: 180rpx;
  height: 180rpx;
  left: 24rpx;
  top: 12rpx;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.18), rgba(59, 130, 246, 0));
  animation: orbFloatA 6s ease-in-out infinite;
}

.ambient-orb-b {
  width: 220rpx;
  height: 220rpx;
  right: 16rpx;
  top: -10rpx;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.16), rgba(99, 102, 241, 0));
  animation: orbFloatB 7s ease-in-out infinite;
}

.chat-bottom-space {
  height: 40rpx;
}

.input-area {
  padding: 14rpx 20rpx 18rpx;
  background: rgba(245, 247, 250, 0.95);
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  transform: translateY(-20rpx);
  box-sizing: border-box;
}

.voice-tip {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #edf4ff;
  border: 1rpx solid #dbeafe;
  color: #3b82f6;
  font-size: 22rpx;
}

.upload-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.upload-btn {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(147, 197, 253, 0.65);
  box-shadow: 0 10rpx 22rpx rgba(59, 130, 246, 0.12);
  color: #1d4ed8;
  font-weight: 600;
}

.upload-btn-disabled {
  opacity: 0.6;
}

.upload-icon {
  font-size: 30rpx;
  line-height: 1;
}

.upload-text {
  font-size: 24rpx;
}

.doc-sheet {
  background: rgba(2, 6, 23, 0.75);
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  border-radius: 18rpx;
  padding: 18rpx 16rpx;
  box-shadow: 0 20rpx 60rpx rgba(2, 6, 23, 0.25);
  margin-bottom: 12rpx;
}

.doc-sheet-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.doc-sheet-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.doc-sheet-file-icon {
  font-size: 34rpx;
  color: #60a5fa;
}

.doc-sheet-file-title {
  color: rgba(255, 255, 255, 0.95);
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 520rpx;
}

.doc-sheet-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.doc-sheet-actions {
  margin-top: 12rpx;
}

.doc-sheet-ok {
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f8dff, #6366f1);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.doc-chip-row {
  margin-bottom: 12rpx;
}

.doc-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(219, 234, 254, 1);
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.06);
}

.doc-chip-icon {
  font-size: 34rpx;
  color: #2563eb;
}

.doc-chip-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doc-chip-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(2, 6, 23, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(2, 6, 23, 0.45);
  font-size: 30rpx;
}

@keyframes gradientFlow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes modelShine {
  0% {
    background-position: 0% 50%;
  }
  100% {
    background-position: 220% 50%;
  }
}

@keyframes cardFloat {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-6rpx);
  }
  100% {
    transform: translateY(0);
  }
}

@keyframes haloMove {
  0% {
    transform: translateY(0) translateX(0);
  }
  50% {
    transform: translateY(14rpx) translateX(-12rpx);
  }
  100% {
    transform: translateY(0) translateX(0);
  }
}

@keyframes badgePulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes chipFadeIn {
  0% {
    opacity: 0;
    transform: translateY(10rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes orbFloatA {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
  100% {
    transform: translateY(0);
  }
}

@keyframes orbFloatB {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10rpx);
  }
  100% {
    transform: translateY(0);
  }
}

/* Rag 历史对话抽屉（复用 ai-chat 的 drawer 样式） */
.history-icon {
  color: #334155;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 14rpx rgba(15, 23, 42, 0.08);
}

.drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(2, 6, 23, 0.25);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
  z-index: 9;
}

.drawer-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.history-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 72%;
  height: 100vh;
  background: #ffffff;
  transform: translateX(100%);
  transition: transform 240ms ease;
  z-index: 10;
  display: flex;
  flex-direction: column;
  box-shadow: -12rpx 0 26rpx rgba(15, 23, 42, 0.12);
}

.history-drawer.open {
  transform: translateX(0);
}

.drawer-header {
  padding: 28rpx 24rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.drawer-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 600;
}

.drawer-close {
  font-size: 44rpx;
  color: #64748b;
  line-height: 1;
}

.drawer-new {
  margin: 0 18rpx 12rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.drawer-list {
  flex: 1;
  padding: 0 18rpx 24rpx;
  box-sizing: border-box;
}

.drawer-item {
  padding: 18rpx 12rpx;
  color: #1f2937;
  font-size: 26rpx;
  border-radius: 10rpx;
}

.drawer-item:active {
  background: #f8fafc;
}

.drawer-empty {
  margin-top: 80rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}

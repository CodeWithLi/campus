<view class="page">
  <scroll-view class="page-scroll" scroll-y>
    <view class="hero-card">
      <view class="hero-glow hero-glow-top"></view>
      <view class="hero-glow hero-glow-bottom"></view>
      <view class="hero-top">
        <view class="hero-main">
          <view class="hero-title">AI 简历工作台</view>
          <view class="hero-desc">从信息整理到排版生成，丝滑完成一份更有竞争力的简历</view>
          <picker
            mode="selector"
            range="{{modelOptions}}"
            range-key="modelName"
            value="{{selectedModelIndex}}"
            bindchange="onModelChange"
          >
            <view class="model-switch">
              <text class="model-prefix">对话模型</text>
              <text class="model-name">{{modelOptions[selectedModelIndex].modelName || selectedModelCode || '请选择模型'}}</text>
              <text class="model-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="hero-actions">
          <view class="hero-btn ghost" bindtap="goHistory">历史会话</view>
          <view class="hero-btn" bindtap="onNewConversation">新建会话</view>
        </view>
      </view>
      <view class="hero-stats">
        <view class="stat-item">
          <view class="stat-value">{{chatList.length}}</view>
          <view class="stat-label">对话条数</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <view class="stat-value">{{resumeText.length}}</view>
          <view class="stat-label">简历字数</view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <view class="stat-value">{{generateResult.links && generateResult.links.length ? '已生成' : '待生成'}}</view>
          <view class="stat-label">当前状态</view>
        </view>
      </view>
      <view class="flow-row">
        <view class="flow-item active">1 编辑内容</view>
        <view class="flow-line"></view>
        <view class="flow-item active">2 AI润色</view>
        <view class="flow-line"></view>
        <view class="flow-item">3 生成链接</view>
      </view>
    </view>

    <view class="section-card resume-card">
      <view class="section-head">
        <view class="section-title">简历编辑区</view>
        <view class="section-tip">先把核心内容整理好，再交给 AI 进一步优化</view>
      </view>
      <view class="meta-grid">
        <view class="field">
          <view class="field-label">模板类型</view>
          <picker mode="selector" range="{{templateOptions}}" range-key="label" value="{{templateIndex}}" bindchange="onTemplateChange">
            <view class="meta-picker">{{templateOptions[templateIndex].label}}</view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">岗位方向</view>
          <input
            class="meta-input"
            placeholder="如：Java后端 / 产品经理"
            value="{{jobDirection}}"
            bindinput="onJobDirectionInput"
          />
        </view>
      </view>
      <view class="resume-head">
        <view class="resume-label">简历正文</view>
        <view class="resume-count">{{resumeText.length}} 字</view>
      </view>
      <textarea
        class="resume-text"
        placeholder="可手动输入，也可先通过对话区让AI生成后粘贴到这里"
        value="{{resumeText}}"
        bindinput="onResumeTextInput"
        maxlength="-1"
      />
      <view class="actions">
        <view class="action-btn subtle" bindtap="onFillFromLastAssistant">填充最近 AI 回复</view>
        <view class="action-btn primary {{loading ? 'disabled' : ''}}" bindtap="onGenerateResume">
          {{loading ? '生成中...' : '调用星火生成简历'}}
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">AI 对话区</view>
        <view class="section-tip">通过追问细化内容，一键补齐简历亮点</view>
      </view>
      <view class="quick-row">
        <view
          wx:for="{{quickQuestionList}}"
          wx:key="index"
          class="quick-pill"
          data-question="{{item}}"
          bindtap="onSendQuickQuestion"
        >
          {{item}}
        </view>
      </view>
      <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
        <view wx:if="{{chatList.length === 0}}" class="chat-empty">
          暂无对话，先点一个快捷问题，或直接在底部输入你的简历需求
        </view>
        <block wx:for="{{chatList}}" wx:key="id">
          <view class="msg {{item.role}}">
            <view class="role-tag {{item.role}}">{{item.role === 'user' ? '我' : 'AI'}}</view>
            <view id="msg-{{item.id}}" class="bubble">{{item.content}}</view>
          </view>
        </block>
        <view id="bottom-anchor-{{anchorKey}}" class="bottom-space"></view>
      </scroll-view>
    </view>

    <view wx:if="{{generateResult.links && generateResult.links.length}}" class="section-card result-card">
      <view class="section-head">
        <view class="section-title">生成结果</view>
        <view class="section-tip">可复制链接或直接下载 Word</view>
      </view>
      <block wx:for="{{generateResult.links}}" wx:key="index">
        <view class="link-item">
          <view class="link-label">Word 链接</view>
          <text selectable class="link-text">{{item.wordUrl || '暂无'}}</text>
          <view class="link-label">图片链接</view>
          <text selectable class="link-text">{{item.imgUrl || '暂无'}}</text>
          <view class="link-actions">
            <view class="mini-btn" wx:if="{{item.wordUrl}}" data-url="{{item.wordUrl}}" bindtap="onCopyLink">复制Word链接</view>
            <view class="mini-btn" wx:if="{{item.imgUrl}}" data-url="{{item.imgUrl}}" bindtap="onCopyLink">复制图片链接</view>
            <view class="mini-btn primary" wx:if="{{item.wordUrl}}" data-url="{{item.wordUrl}}" bindtap="onDownloadWord">下载Word</view>
          </view>
        </view>
      </block>
    </view>
    <view class="page-bottom-space"></view>
  </scroll-view>

  <view class="input-area">
    <ai-input loading="{{loading || voiceLoading}}" bind:send="onSendMessage" bind:voice="onVoiceTap" />
    <view wx:if="{{recording}}" class="voice-tip">正在录音并实时转写，点击麦克风结束</view>
    <view wx:if="{{recording && voiceLoading && liveSpeechText}}" class="voice-tip">实时识别：{{liveSpeechText}}</view>
    <view wx:if="{{!recording && voiceLoading}}" class="voice-tip">已停止录音，正在识别最后内容...</view>
  </view>

  <view class="drawer-mask {{showHistoryDrawer ? 'show' : ''}}" bindtap="closeHistoryDrawer"></view>
  <view class="history-drawer {{showHistoryDrawer ? 'open' : ''}}">
    <view class="drawer-header">
      <view class="drawer-title">简历历史会话</view>
      <view class="drawer-close" bindtap="closeHistoryDrawer">×</view>
    </view>
    <scroll-view class="drawer-list" scroll-y>
      <view wx:if="{{historyList.length === 0}}" class="drawer-empty">暂无历史会话</view>
      <view
        wx:for="{{historyList}}"
        wx:key="conversationId"
        class="drawer-item"
        data-conversation-id="{{item.conversationId}}"
        bindtap="onSelectHistory"
      >
        <view class="drawer-item-title">{{item.conversationTitle || '新会话'}}</view>
      </view>
    </scroll-view>
  </view>
</view>


<view class="page">
  <view class="hero-card">
    <view class="hero-title">AI 工作台</view>
    <view class="hero-desc">先完成对话功能，RAG 入口已预留。</view>
  </view>

  <view
    class="entry-card"
    wx:for="{{entries}}"
    wx:key="key"
    data-action="{{item.action}}"
    bindtap="onEntryTap"
  >
    <view class="entry-title">{{item.title}}</view>
    <view class="entry-desc">{{item.desc}}</view>
    <view class="entry-btn">进入</view>
  </view>
</view>

<view class="page">
  <view class="card">
    <view class="title">校验方式</view>
    <view class="verify-switch">
      <view class="switch-item {{verifyType === 'EMAIL_CODE' ? 'active' : ''}}" data-type="EMAIL_CODE" bindtap="onSwitchVerifyType">
        邮箱验证码
      </view>
      <view class="switch-item {{verifyType === 'WX_ONE_CLICK' ? 'active' : ''}}" data-type="WX_ONE_CLICK" bindtap="onSwitchVerifyType">
        微信一键验证
      </view>
    </view>

    <view wx:if="{{verifyType === 'EMAIL_CODE'}}" class="code-wrap">
      <input class="input" placeholder="请输入邮箱验证码" value="{{emailCode}}" bindinput="onInputEmailCode" />
      <button class="ghost-btn" loading="{{sendingCode}}" bindtap="onSendCode">发送验证码</button>
    </view>

    <view wx:if="{{verifyType === 'WX_ONE_CLICK'}}" class="tip">
      提交时会拉起微信身份校验，仅当前账号绑定的微信可通过。
    </view>
  </view>

  <view class="card">
    <view class="title">新密码</view>
    <input password class="input" placeholder="请输入新密码（至少6位）" value="{{newPassword}}" bindinput="onInputNewPassword" />
    <input password class="input mt12" placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onInputConfirmPassword" />
    <button class="primary-btn" loading="{{loading}}" bindtap="onSubmit">确认修改</button>
  </view>
</view>

.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 16rpx;
}

.title {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
}

.verify-switch {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.switch-item.active {
  background: #fff;
  color: #2563eb;
  font-weight: 600;
}

.code-wrap {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}

.ghost-btn {
  min-width: 170rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  background: #dbeafe;
}

.ghost-btn::after,
.primary-btn::after {
  border: none;
}

.tip {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.6;
}

.mt12 {
  margin-top: 12rpx;
}

.primary-btn {
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f7dff 0%, #6ea4ff 100%);
  color: #fff;
  font-size: 26rpx;
}

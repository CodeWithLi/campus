<view class="page">
  <view class="filter-card">
    <input class="input" placeholder="搜索标题或简介" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <picker class="category-picker" mode="selector" range="{{categoryOptions}}" value="{{selectedCategoryIndex}}" bindchange="onCategoryChange">
      <view class="input picker-view">
        {{categoryOptions[selectedCategoryIndex] || '全部分类'}}
      </view>
    </picker>
    <button class="search-btn" bindtap="onSearch" loading="{{loading}}">查询</button>
  </view>

  <view wx:if="{{!loading && !list.length}}" class="empty">
    <view class="empty-title">暂无已上架指南</view>
    <view class="empty-text">请到后台上架后查看</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="guide-card"
    data-id="{{item.id}}"
    bindtap="onOpenDetail"
  >
    <view class="guide-top">
      <view class="guide-title">{{item.title}}</view>
      <view wx:if="{{item.tag}}" class="guide-tag">{{item.tag}}</view>
    </view>
    <view class="guide-meta">{{item.category || '未分类'}}</view>
    <view class="guide-summary">{{item.summary || '暂无简介'}}</view>
    <view class="guide-action">查看详情 ></view>
  </view>
</view>

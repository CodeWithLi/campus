<view class="page {{isLogin ? '' : 'guest-page'}}">
  <view wx:if="{{!isLogin}}" class="guest-wrap">
    <view class="guest-bg">
      <view class="blob blob-1"></view>
      <view class="blob blob-2"></view>
      <view class="blob blob-3"></view>
      <view class="grid"></view>
    </view>
    <view class="guest-card">
      <view class="guest-top-row">
        <view class="guest-left">
          <view class="guest-avatar">头像</view>
        </view>
        <view class="guest-right">
          <view class="guest-title">未登录</view>
          <view class="guest-desc">登录后可使用提醒与社区功能</view>
        </view>
      </view>
      <view class="guest-btn-row">
        <button class="guest-btn" bindtap="goLogin">去登录 / 注册</button>
      </view>
    </view>
  </view>

  <view wx:else class="profile-card">
    <view class="profile-top">
      <image
        wx:if="{{avatarPreviewUrl}}"
        class="avatar"
        src="{{avatarPreviewUrl}}"
        mode="aspectFill"
        bindtap="onChooseAvatar"
      />
      <view wx:else class="avatar avatar-placeholder" bindtap="onChooseAvatar">头像</view>
      <view class="profile-meta">
        <view class="name">{{nickname || username || '微信用户'}}</view>
        <view class="desc">{{email || '已登录，点击头像可更换'}}</view>
        <view class="points-line">
          <text class="points-label">算力点</text>
          <text class="points-value">{{powerPoints}}</text>
        </view>
        <view class="name-edit-line">
          <text class="name-edit-btn" bindtap="onEditNickname">修改昵称</text>
        </view>
      </view>
    </view>
  </view>

  <view class="recharge-card-wrap" wx:if="{{isLogin}}">
    <view class="recharge-card" bindtap="goPowerPointsCenter">
      <view class="recharge-orb orb-1"></view>
      <view class="recharge-orb orb-2"></view>
      <view class="recharge-shine"></view>
      <view class="recharge-main">
        <view class="recharge-title">充值特惠！</view>
        <view class="recharge-subtitle">1元=100算力点，享受更顺畅的AI体验</view>
      </view>
      <view class="recharge-side">
        <view class="recharge-balance">⚡ {{powerPoints}}</view>
        <view class="recharge-btn">去充值</view>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{isLogin}}">
    <view class="section-title">社区与提醒</view>
    <view class="menu-item" bindtap="goResumeRecords">
      <view class="menu-left">
        <text class="menu-icon">📄</text>
        <text class="menu-text">我的简历</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyPosts">
      <view class="menu-left">
        <text class="menu-icon">📝</text>
        <text class="menu-text">我的帖子</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyFavorites">
      <view class="menu-left">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">我的收藏</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMyInteractions">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-text">我的互动</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goScheduleReminder">
      <view class="menu-left">
        <text class="menu-icon">⏰</text>
        <text class="menu-text">日程提醒</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goNotificationCenter">
      <view class="menu-left">
        <text class="menu-icon">🔔</text>
        <text class="menu-text">通知中心</text>
      </view>
      <view class="menu-right">
        <text wx:if="{{unreadNoticeCount > 0}}" class="badge">{{unreadNoticeCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{isLogin}}">
    <view class="section-title">算力点</view>
    <view class="menu-item" bindtap="goPowerPointLogs">
      <view class="menu-left">
        <text class="menu-icon">💳</text>
        <text class="menu-text">扣费明细</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goRechargeOrders">
      <view class="menu-left">
        <text class="menu-icon">🧾</text>
        <text class="menu-text">充值订单</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="section-card" wx:if="{{isLogin}}">
    <view class="section-title">账号安全</view>
    <view class="menu-item" bindtap="goChangePassword">
      <view class="menu-left">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">修改密码</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>

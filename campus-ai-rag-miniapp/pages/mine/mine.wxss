.page {
  min-height: 100vh;
  background: #f6f8fc;
  padding: 24rpx;
  box-sizing: border-box;
}

.profile-card {
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  color: #ffffff;
  background: linear-gradient(140deg, #5e89ff 0%, #7f7bff 100%);
  box-shadow: 0 14rpx 30rpx rgba(86, 115, 232, 0.26);
}

.profile-card.guest {
  background: linear-gradient(140deg, #8ea8e0 0%, #9f95df 100%);
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.2);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.94;
  line-height: 1.4;
}

.profile-actions {
  margin-top: 20rpx;
}

.login-btn {
  border-radius: 999rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
}

.login-btn::after {
  border: 1rpx solid rgba(255, 255, 255, 0.42);
}

.section-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e9edf7;
  padding: 12rpx 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.05);
}

.section-title {
  font-size: 26rpx;
  color: #94a3b8;
  padding: 16rpx 0 8rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 86rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.menu-icon {
  font-size: 28rpx;
}

.menu-text {
  color: #0f172a;
  font-size: 28rpx;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.menu-arrow {
  color: #cbd5e1;
  font-size: 34rpx;
  line-height: 1;
}

.badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 0 8rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
}

.logout-wrap {
  margin-top: 30rpx;
}

.logout-btn {
  border-radius: 14rpx;
  height: 82rpx;
  line-height: 82rpx;
  background: #ffffff;
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 600;
}

.logout-btn::after {
  border: 1rpx solid #fecaca;
}

.token-hidden {
  flex: 1;
  overflow: hidden;
}

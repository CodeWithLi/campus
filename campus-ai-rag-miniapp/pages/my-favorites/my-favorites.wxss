.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.content {
  margin-top: 10rpx;
  color: #4b5563;
  font-size: 24rpx;
}

.meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  color: #94a3b8;
  font-size: 22rpx;
}

.empty {
  margin-top: 180rpx;
  text-align: center;
  color: #94a3b8;
}

.more-btn {
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
}

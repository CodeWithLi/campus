<view class="page">
  <view class="head-card">
    <view class="title">通知中心</view>
    <view class="sub">未读 {{unreadCount}} 条</view>
    <button class="read-all-btn" wx:if="{{list.length}}" bindtap="onMarkAllRead">全部已读</button>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty-card">
    <view class="empty-icon">🔔</view>
    <view class="empty-text">暂无通知</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="notice-item {{item.read ? 'read' : 'unread'}}"
    data-id="{{item.id}}"
    bindtap="onTapNotice"
  >
    <view class="notice-top">
      <view class="notice-type">{{item.typeText}}提醒</view>
      <view class="notice-time">{{item.createdAt}}</view>
    </view>
    <view class="notice-title">{{item.title}}</view>
    <view class="notice-content">{{item.content}}</view>
  </view>
</view>

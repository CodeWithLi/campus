.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #f3f7ff 38%, #f6fbff 100%);
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

.fade-in {
  animation: fadeIn 260ms ease-out both;
}

.delay-1 {
  animation-delay: 70ms;
}

.delay-2 {
  animation-delay: 120ms;
}

.delay-3 {
  animation-delay: 170ms;
}

.bg-orb {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}

.orb-a {
  width: 340rpx;
  height: 340rpx;
  right: -110rpx;
  top: -80rpx;
  background: radial-gradient(circle at 30% 30%, rgba(182, 199, 255, 0.55), rgba(182, 199, 255, 0));
}

.orb-b {
  width: 420rpx;
  height: 420rpx;
  left: -180rpx;
  top: 380rpx;
  background: radial-gradient(circle at 50% 50%, rgba(255, 200, 230, 0.42), rgba(255, 200, 230, 0));
}

.orb-c {
  width: 300rpx;
  height: 300rpx;
  right: -90rpx;
  bottom: 120rpx;
  background: radial-gradient(circle at 50% 50%, rgba(203, 235, 255, 0.48), rgba(203, 235, 255, 0));
}

.hero-card {
  position: relative;
  z-index: 1;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94) 0%, rgba(244, 249, 255, 0.94) 100%);
  border: 1rpx solid rgba(193, 214, 255, 0.65);
  border-radius: 30rpx;
  padding: 30rpx 24rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 38rpx rgba(95, 126, 220, 0.12);
}

.hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-title {
  color: #22335a;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #6880a8;
  font-size: 24rpx;
}

.hero-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffd7ea 0%, #e8dcff 100%);
  color: #7b4cc7;
  font-size: 20rpx;
  font-weight: 700;
}

.tab-row {
  margin-top: 22rpx;
  background: linear-gradient(180deg, #eef3ff 0%, #e8efff 100%);
  border-radius: 999rpx;
  padding: 7rpx;
  display: flex;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5c6a85;
  font-weight: 500;
  transition: transform 140ms ease, background-color 140ms ease, color 140ms ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
  color: #3d61f0;
  font-weight: 600;
  box-shadow: 0 8rpx 16rpx rgba(111, 134, 238, 0.2);
}

.tab-item-hover {
  transform: scale(0.98);
}

.section-card {
  position: relative;
  z-index: 1;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 251, 255, 0.95) 100%);
  border: 1rpx solid rgba(215, 229, 255, 0.8);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 14rpx 34rpx rgba(90, 117, 205, 0.1);
}

.ai-card {
  background: linear-gradient(145deg, rgba(255, 252, 255, 0.96) 0%, rgba(247, 250, 255, 0.96) 100%);
}

.section-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.section-title {
  width: 100%;
  font-size: 31rpx;
  color: #253857;
  font-weight: 600;
  line-height: 1.35;
  white-space: normal;
  word-break: break-all;
}

.section-chip {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #b15d9f;
  background: #ffeaf7;
}

.section-chip.blue {
  color: #3c6dd8;
  background: #e8f1ff;
}

.section-chip.purple {
  color: #6f58c9;
  background: #eee9ff;
}

.input,
.textarea {
  width: 100%;
  background: linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
  border: 2rpx solid #e6edfb;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #304362;
}

.input {
  height: 74rpx;
  line-height: 74rpx;
  padding: 0 20rpx;
}

.textarea {
  padding: 18rpx 20rpx;
  line-height: 1.6;
}

.hint-textarea {
  height: 206rpx;
}

.content-textarea {
  height: 360rpx;
  margin-top: 16rpx;
}

.row-end {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.counter {
  margin-top: 12rpx;
  text-align: right;
  color: #93a3bf;
  font-size: 22rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.image-item {
  position: relative;
}

.image {
  width: 100%;
  height: 196rpx;
  border-radius: 16rpx;
  background: #edf2ff;
  border: 1rpx solid #dce7ff;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.image:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 18rpx rgba(105, 132, 224, 0.2);
}

.image-delete {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: rgba(46, 64, 118, 0.72);
  color: #fff;
  line-height: 38rpx;
  text-align: center;
  font-size: 24rpx;
}

.image-add {
  height: 196rpx;
  border: 2rpx dashed #bad0ff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f7faff 0%, #eef4ff 100%);
  transition: transform 160ms ease, border-color 160ms ease, background-color 160ms ease;
}

.image-add-hover {
  transform: scale(0.98);
  border-color: #8cb3ff;
  background: #eaf2ff;
}

.add-plus {
  font-size: 42rpx;
  line-height: 1;
  color: #5b7ce2;
  margin-bottom: 8rpx;
}

.add-text {
  color: #5672b8;
  font-size: 24rpx;
  font-weight: 500;
}

.tip {
  margin-top: 14rpx;
  color: #8aa0c5;
  font-size: 22rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(246, 249, 255, 0.2) 0%, rgba(246, 249, 255, 0.96) 45%);
  backdrop-filter: blur(8rpx);
  box-sizing: border-box;
}

.publish-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #5a7dff 0%, #7397ff 45%, #68a9ff 100%);
  color: #fff;
  box-shadow: 0 14rpx 24rpx rgba(95, 129, 233, 0.35);
  transition: transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
}

.publish-btn:active {
  box-shadow: 0 10rpx 18rpx rgba(95, 129, 233, 0.28);
}

.secondary-btn {
  min-width: 196rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: linear-gradient(135deg, #e7edff 0%, #dbe6ff 100%);
  color: #3b5ecf;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 16rpx rgba(123, 147, 225, 0.2);
  transition: transform 160ms ease, opacity 160ms ease, box-shadow 160ms ease;
}

.secondary-btn:active {
  box-shadow: 0 5rpx 10rpx rgba(123, 147, 225, 0.14);
}

.secondary-btn::after,
.publish-btn::after {
  border: none;
}

.btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx) scale(0.995);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

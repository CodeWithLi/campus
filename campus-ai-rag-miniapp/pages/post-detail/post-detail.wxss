.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.fade-in {
  animation: fadeIn 260ms ease-out both;
}

.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.06);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.12);
}

.title {
  font-size: 34rpx;
  color: #111827;
  font-weight: 700;
}

.meta-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-user {
  color: #3b82f6;
  font-size: 22rpx;
}

.meta-time {
  color: #9ca3af;
  font-size: 22rpx;
}

.content {
  margin-top: 20rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.images {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.actions {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.action-btn {
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.action-btn.active {
  background: #dbeafe;
  color: #1d4ed8;
}

.comment-card {
  margin-top: 14rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(80, 102, 177, 0.1);
}

.comment-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-title {
  font-size: 30rpx;
  color: #1f2d4b;
  font-weight: 600;
}

.comment-count {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e9f1ff;
  color: #3b82f6;
  font-size: 20rpx;
}

.comment-editor {
  margin-top: 14rpx;
  background: #f7faff;
  border: 1rpx solid #e5edff;
  border-radius: 18rpx;
  padding: 16rpx;
}

.reply-tip {
  margin-bottom: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #eef4ff;
  font-size: 22rpx;
  color: #4b5f87;
}

.reply-cancel {
  margin-left: 12rpx;
  color: #2563eb;
  font-weight: 600;
}

.comment-input {
  background: #ffffff;
  border: 1rpx solid #dbe7ff;
  border-radius: 14rpx;
  min-height: 160rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #1e293b;
  line-height: 1.6;
  box-sizing: border-box;
  overflow-y: auto;
}

.comment-submit-row {
  margin-top: 14rpx;
  padding: 12rpx 0 16rpx;
  display: flex;
  justify-content: flex-end;
}

.comment-submit-btn {
  min-width: 224rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #5f87ff 0%, #7ea8ff 55%, #8bc4ff 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  padding: 0 30rpx;
  box-shadow: 0 10rpx 20rpx rgba(93, 139, 240, 0.32);
  transition: transform 140ms ease, box-shadow 140ms ease, opacity 140ms ease;
}

.comment-submit-btn:active {
  transform: translateY(1rpx) scale(0.98);
  box-shadow: 0 6rpx 12rpx rgba(93, 139, 240, 0.24);
}

.comment-submit-btn::after {
  border: none;
}

.comment-empty {
  margin-top: 18rpx;
  padding: 30rpx 16rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  text-align: center;
}

.comment-empty-icon {
  font-size: 36rpx;
}

.comment-empty-text {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.comment-item {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.comment-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #dbeafe 0%, #e9d5ff 100%);
  color: #3b82f6;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.comment-user {
  font-size: 24rpx;
  color: #24324d;
  font-weight: 600;
}

.comment-time {
  font-size: 20rpx;
  color: #9ca3af;
  white-space: nowrap;
}

.comment-bubble {
  margin-top: 6rpx;
  background: #f5f8ff;
  border: 1rpx solid #e2eafe;
  border-radius: 14rpx;
  padding: 8rpx 12rpx;
}

.comment-content {
  font-size: 24rpx;
  color: #334155;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-all;
}

.reply-prefix {
  color: #1d4ed8;
}

.comment-op {
  margin-top: 6rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ecf4ff;
  color: #2563eb;
  font-size: 22rpx;
}

.img {
  width: 100%;
  height: 196rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  animation: fadeIn 260ms ease-out both;
  transition: transform 160ms ease;
}

.img:active {
  transform: scale(0.98);
}

.empty {
  text-align: center;
  color: #64748b;
  margin-top: 200rpx;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

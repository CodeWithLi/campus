<view class="page">
  <view class="top-card fade-in">
    <view class="page-title">社区帖子</view>
    <view class="page-subtitle">浏览最新发布内容</view>
    <view class="tab-row">
      <view class="tab-item active">社区帖子</view>
      <view class="tab-item" hover-class="tab-item-hover" hover-stay-time="70" bindtap="onMyPosts">我的帖子</view>
      <view class="tab-item" hover-class="tab-item-hover" hover-stay-time="70" bindtap="onCreatePost">去发帖</view>
    </view>
  </view>

  <view wx:if="{{list.length === 0 && !loading}}" class="empty">
    <view class="empty-title">还没有社区帖子</view>
    <view class="empty-text">发布第一条内容，开启讨论。</view>
  </view>

  <view
    class="post-card fade-in"
    wx:for="{{list}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onOpenDetail"
    hover-class="card-hover"
    hover-stay-time="90"
    style="animation-delay: {{(index % 8) * 60}}ms;"
  >
    <view class="title line-2">{{item.title}}</view>
    <view class="content">{{item.contentPreview}}</view>
    <view class="images" wx:if="{{item.fullImageUrls && item.fullImageUrls.length}}">
      <image wx:for="{{item.fullImageUrls}}" wx:key="index" class="thumb" mode="aspectFill" src="{{item}}" />
    </view>
    <view class="meta">
      <view class="meta-left">{{item.nickname || ('用户 ' + item.userId)}}</view>
      <view class="meta-right-wrap">
        <view class="meta-right">{{item.createdAt || ''}}</view>
        <view class="meta-stats">
          <text class="stat-item">👍 {{item.likeCount || 0}}</text>
          <text class="stat-item">💬 {{item.commentCount || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="more-wrap" wx:if="{{hasMore}}">
    <button class="more-btn" hover-class="btn-hover" loading="{{loadingMore}}" bindtap="onLoadMore">加载更多</button>
  </view>
</view>

.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.fade-in {
  animation: fadeIn 260ms ease-out both;
}

.top-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.06);
}

.page-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.tab-row {
  margin-top: 20rpx;
  background: #f3f4f6;
  border-radius: 999rpx;
  padding: 6rpx;
  display: flex;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  color: #4b5563;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  transition: transform 140ms ease, background-color 140ms ease, color 140ms ease;
}

.tab-item.active {
  background: #ffffff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(37, 99, 235, 0.14);
}

.tab-item-hover {
  transform: scale(0.98);
}

.post-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.card-hover {
  transform: translateY(-2rpx);
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.14);
}

.title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.line-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.content {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.images {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-left {
  font-size: 22rpx;
  color: #3b82f6;
}

.meta-right {
  font-size: 22rpx;
  color: #9ca3af;
}

.meta-right-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.meta-stats {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.stat-item {
  font-size: 22rpx;
  color: #64748b;
}

.empty {
  margin: 180rpx 0 30rpx;
  text-align: center;
}

.empty-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-text {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.more-wrap {
  margin-top: 6rpx;
}

.more-btn {
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  background: #dbeafe;
  transition: transform 160ms ease, opacity 160ms ease;
}

.more-btn::after {
  border: none;
}

.btn-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

<view class="page">
  <view class="balance-card">
    <view class="balance-title">当前算力点</view>
    <view class="balance-value">{{powerPoints}}</view>
    <view class="balance-tip" bindtap="onExplain">1元=100算力点</view>
  </view>

  <view class="section-title">充值档位</view>
  <view class="grid">
    <view
      class="pkg"
      wx:for="{{packages}}"
      wx:key="price"
      data-price="{{item.price}}"
      data-points="{{item.points}}"
      bindtap="onTapPackage"
    >
      <view class="pkg-price">￥{{item.price}}</view>
      <view class="pkg-points">{{item.points}} 算力点</view>
      <view class="pkg-btn">立即充值</view>
    </view>
  </view>
</view>


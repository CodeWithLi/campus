<view class="page">
  <view wx:if="{{!list.length && !loading}}" class="empty">
    暂无扣费明细
  </view>

  <view class="card" wx:for="{{list}}" wx:key="index">
    <view class="line">
      <text class="scene">{{item.sceneName}}</text>
      <text class="points">-{{item.consumedPoints}} 算力点</text>
    </view>
    <view class="time">{{item.createdAtText}}</view>
  </view>

  <view wx:if="{{loading}}" class="footer">加载中...</view>
  <view wx:elif="{{list.length && !hasMore}}" class="footer">没有更多了</view>
</view>


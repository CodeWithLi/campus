.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.input {
  margin-top: 14rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  height: 74rpx;
  line-height: 74rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.row {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.field {
  flex: 1;
}

.label {
  font-size: 22rpx;
  color: #6b7280;
}

.picker {
  margin-top: 8rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
}

.create-btn {
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f7dff 0%, #6ea4ff 100%);
  color: #fff;
  font-size: 26rpx;
}

.create-btn::after {
  border: none;
}

.vision-btn {
  margin-top: 14rpx;
  background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
}

.tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.empty {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.item {
  margin-top: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #e0e7ff;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.swipe-wrap {
  position: relative;
  overflow: hidden;
  margin-top: 12rpx;
  border-radius: 14rpx;
}

.swipe-item {
  margin-top: 0;
  transition: transform 0.18s ease;
}

.swipe-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 150rpx;
  background: #ef4444;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 600;
}

.item-title-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-sub {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.item-sub-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-del {
  color: #ef4444;
  font-size: 22rpx;
}

.agent-box {
  margin-top: 14rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  border-radius: 14rpx;
  padding: 14rpx;
}

.agent-route {
  color: #1d4ed8;
  font-size: 22rpx;
}

.agent-summary {
  margin-top: 8rpx;
  color: #334155;
  font-size: 24rpx;
}

.agent-item {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.dialog-card {
  width: 88%;
  max-height: 78vh;
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.dialog-sub {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  word-break: break-all;
}

.dialog-body {
  margin-top: 14rpx;
  max-height: 54vh;
}

.dialog-label {
  margin-top: 10rpx;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 600;
}

.dialog-text {
  margin-top: 6rpx;
  color: #1f2937;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-all;
}

.dialog-item {
  margin-top: 8rpx;
  padding: 8rpx 10rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
}

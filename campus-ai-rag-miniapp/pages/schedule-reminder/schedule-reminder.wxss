.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.input {
  margin-top: 14rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  height: 74rpx;
  line-height: 74rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
}

.row {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.field {
  flex: 1;
}

.label {
  font-size: 22rpx;
  color: #6b7280;
}

.picker {
  margin-top: 8rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
}

.create-btn {
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #4f7dff 0%, #6ea4ff 100%);
  color: #fff;
  font-size: 26rpx;
}

.create-btn::after {
  border: none;
}

.tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.empty {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.item {
  margin-top: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #e0e7ff;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 600;
}

.item-sub {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.item-del {
  color: #ef4444;
  font-size: 22rpx;
}
